    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "resend": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
